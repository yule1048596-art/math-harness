# Copy this file to .env. Never commit the real .env file.

# Offline method extraction avoids an extra model call during ingestion.
MATH_HARNESS_METHOD_EXTRACTOR=rules

# Xiaomi MiMo candidate generation with deterministic SymPy fallback.
MATH_HARNESS_SOLVER=mimo
# Draft untrusted, user-confirmed verification targets with MiMo. Omit this line
# to follow the configured online solver automatically, or use rules for offline.
MATH_HARNESS_TARGET_DRAFTER=mimo
# Use the same provider for persistent natural-language conversations. Set to
# offline to keep conversation storage local without making chat model calls.
MATH_HARNESS_CONVERSATION_PROVIDER=mimo
MIMO_API_KEY=replace-with-your-mimo-key
MATH_HARNESS_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MATH_HARNESS_MIMO_MODEL=mimo-v2.5-pro
MATH_HARNESS_MIMO_SOLVER_REASONING_EFFORT=none
MATH_HARNESS_MIMO_TIMEOUT_SECONDS=60
MATH_HARNESS_MIMO_TARGET_REASONING_EFFORT=none
MATH_HARNESS_MIMO_TARGET_MAX_OUTPUT_TOKENS=1500
MATH_HARNESS_MIMO_CHAT_REASONING_EFFORT=none

# Extract durable user profile, learning goals, explanation preferences, and
# topic context after chat turns. This worker never receives assistant replies
# or trusted method cards. Omit the model override to reuse MATH_HARNESS_MIMO_MODEL.
MATH_HARNESS_MEMORY_EXTRACTOR=mimo
MATH_HARNESS_MIMO_MEMORY_MODEL=mimo-v2.5-pro
MATH_HARNESS_MIMO_MEMORY_REASONING_EFFORT=none

# A rejected model candidate gets one verifier-guided repair request. If that
# still fails, the deterministic SymPy solver becomes the verified fallback.
# Disable repair to avoid the possible extra billable request.
MATH_HARNESS_VERIFICATION_REPAIR=true
MATH_HARNESS_VERIFICATION_FALLBACK=true

# For difficult problems, use high reasoning together with max_output_tokens=8000
# in the solve request, and raise this timeout to 180 seconds.

# Optional: use MiMo for method extraction too.
# MATH_HARNESS_METHOD_EXTRACTOR=mimo
# MATH_HARNESS_MIMO_EXTRACTION_REASONING_EFFORT=none
# MATH_HARNESS_MIMO_EXTRACTION_MAX_OUTPUT_TOKENS=3000

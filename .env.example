# Copy this file to .env. Never commit the real .env file.

# Offline method extraction avoids an extra model call during ingestion.
MATH_HARNESS_METHOD_EXTRACTOR=rules

# Xiaomi MiMo candidate generation with deterministic SymPy fallback.
MATH_HARNESS_SOLVER=mimo
MIMO_API_KEY=replace-with-your-mimo-key
MATH_HARNESS_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MATH_HARNESS_MIMO_MODEL=mimo-v2.5-pro
MATH_HARNESS_MIMO_SOLVER_REASONING_EFFORT=none
MATH_HARNESS_MIMO_TIMEOUT_SECONDS=60

# For difficult problems, use high reasoning together with max_output_tokens=8000
# in the solve request, and raise this timeout to 180 seconds.

# Optional: use MiMo for method extraction too.
# MATH_HARNESS_METHOD_EXTRACTOR=mimo
# MATH_HARNESS_MIMO_EXTRACTION_REASONING_EFFORT=none
# MATH_HARNESS_MIMO_EXTRACTION_MAX_OUTPUT_TOKENS=3000
